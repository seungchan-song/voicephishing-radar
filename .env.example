# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채운다.
# .env 는 절대 깃허브에 올리지 않는다 (.gitignore에 들어 있음). 키는 팀장에게 개인 메시지로 받는다.

# MongoDB Atlas 접속 주소 (팀 공용)
MONGO_URI=mongodb+srv://아이디:비밀번호@클러스터주소/?retryWrites=true&w=majority
DB_NAME=voicephishing

# 네이버 뉴스 검색 API (P2)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 경보 메일 (B3). 네이버 메일 설정에서 SMTP 사용을 켠다
MAIL_USER=
MAIL_PASSWORD=
MAIL_TO=받는사람1@example.com,받는사람2@example.com
# (선택) 메일 속 대시보드 링크. 비워 두면 http://127.0.0.1:5000
# DASHBOARD_URL=http://127.0.0.1:5000

# Notion 기록 (B4)
NOTION_TOKEN=
NOTION_DATABASE_ID=
